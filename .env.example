# === API Keys (at least one required for Phase 4 reasoning) ===
# Priority: Groq → Gemini → OpenRouter → template fallback

# Groq API key (recommended — fastest, generous free tier)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Gemini API key (alternative — may require billing for new accounts)
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# OpenRouter API key (fallback)
# Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# === Model Selection ===

# Override the default reasoning model (optional)
# Groq models: llama-3.1-8b-instant, mixtral-8x7b-32768, llama3-70b-8192
# Gemini models: gemini-2.0-flash, gemini-2.5-flash
# OpenRouter: mistralai/mistral-7b-instruct:free, meta-llama/llama-3.2-3b-instruct:free
# REASONING_MODEL=llama-3.1-8b-instant

# === Paths (optional — defaults shown) ===
# DATA_PATH=data/candidates.jsonl
# CACHE_DIR=cache/
# OUTPUT_DIR=output/
