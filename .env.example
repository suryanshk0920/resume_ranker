# === API Keys (ALL OPTIONAL — pipeline runs fully with cached reasoning) ===
# Priority: Groq → Gemini → OpenRouter → NVIDIA → cached reasoning → template

# Groq API key (fastest, generous free tier)
# Get one at https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Gemini API key (alternative)
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# OpenRouter API key (fallback)
# Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# NVIDIA API key (fallback — hosts MiniMax, Mistral, Llama models)
# Get one at https://build.nvidia.com/explore/discover
# NVIDIA_API_KEY=nvapi-...

# === Model Selection ===

# Override the default reasoning model (optional)
# If no model set, defaults to llama-3.1-8b-instant (Groq-compatible)
# Groq models: llama-3.1-8b-instant, mixtral-8x7b-32768, llama3-70b-8192
# Gemini models: gemini-2.0-flash, gemini-2.5-flash
# OpenRouter: google/gemma-4-26b-a4b-it:free, meta-llama/llama-3.2-3b-instruct:free
# NVIDIA: minimaxai/minimax-m3, nvidia/llama-3.1-nemotron-70b-instruct
# REASONING_MODEL=minimaxai/minimax-m3

# === Paths (optional — defaults shown) ===
# DATA_PATH=data/candidates.jsonl
# CACHE_DIR=cache/
# OUTPUT_DIR=output/
